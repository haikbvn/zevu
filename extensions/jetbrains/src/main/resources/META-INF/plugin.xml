<idea-plugin>

  <!-- Unique id for this plugin. Must stay constant for the life of the plugin. -->
  <id>dev.zevu.jetbrains</id>

  <!-- Text to display as name on Preferences/Settings | Plugin page -->
  <name>Zevu Terminal Companion</name>

  <!-- Product and plugin compatibility requirements -->
  <depends>org.jetbrains.plugins.terminal</depends>

  <!-- Text to display as description on Preferences/Settings | Plugin page -->
  <description>
    <![CDATA[
      Zevu Terminal Companion connects your IDE's terminal emulator to Zevu for command-line completions. It does not provide completions in the editor.
    ]]>
  </description>
  <change-notes>
    <![CDATA[
      <ul>
        <li>[0.2.0]: Zevu terminal integration with the bundled Zevu CLI.</li>
      </ul>
    ]]>
  </change-notes>

  <!-- Text to display as company information on Preferences/Settings | Plugin page -->
  <vendor>Zevu</vendor>

  <projectListeners>
    <listener class="io.fig.jetbrains.FigWindowListener"
              topic="com.intellij.openapi.wm.ex.ToolWindowManagerListener" />
  </projectListeners>

  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceImplementation="io.fig.jetbrains.FigService"/>
  </extensions>

  <depends>org.jetbrains.plugins.terminal</depends>
  <depends>com.intellij.modules.platform</depends>

</idea-plugin>
