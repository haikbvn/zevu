{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "zevu-terminal-companion#build": {
      "outputs": ["zevu-terminal-companion-0.2.0.vsix"],
      "cache": false
    },
    "lint": {
      "dependsOn": ["@amzn/eslint-config#build"],
      "cache": false
    },
    "lint:fix": {
      "dependsOn": ["@amzn/eslint-config#build"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
